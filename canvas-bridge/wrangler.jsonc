{
  "name": "spot-plus-canvas",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "durable_objects": {"bindings": [{"name": "INSTALLS", "class_name": "InstallCounter"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["InstallCounter"]}],
  "observability": {"enabled": true, "head_sampling_rate": 0.01}
}
