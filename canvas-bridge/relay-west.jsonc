// A second copy of the Spot+ server, run near aws:us-west-2 so it asks YouTube from different addresses
// than the main one. YouTube refuses servers in bursts per address; when the main one is refused, the app
// retries through these. Only the audio routes are used here. Deploy: wrangler deploy -c relay-west.jsonc
{
  "name": "spot-plus-relay-west",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "placement": {"region": "aws:us-west-2"},
  "observability": {"enabled": true, "head_sampling_rate": 0.01}
}
